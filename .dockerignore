# yaagents gateway — Docker build context exclusions (NFR-GW-1)
#
# Secrets and credential files must never enter the image build context.
# All credentials are runtime env-vars injected by the orchestrator.

# Secret files
.env
.env.*
*.secret
*.pem
*.key

# Test files (not needed in the runtime image)
**/*_test.go

# Development/tooling
.claude/
docs/
.git/
.gitignore
.dockerignore

# Bench runtime artefacts — written during harness.sh runs; NOT needed in the
# gateway image.  Excluding them keeps the COPY . . layer cache stable across
# bench runs (otherwise active-plugins.yaml invalidates the cache every run).
bench/active-plugins.yaml
bench/bodies/
bench/configs/
bench/targets/
bench/results/
